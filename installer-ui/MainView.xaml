<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Surface" Width="840" Height="576" Background="White" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="14"
        TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.Foreground="#202020" TextElement.FontSize="13">
  <Border.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#666666"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="Opacity" Value="0.8"/><Setter TargetName="ButtonBody" Property="BorderBrush" Value="#BBBBBB"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBody" Property="BorderBrush" Value="#777777"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBody" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBody" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="5"/><Setter Property="Background" Value="#E7E7E7"/><Setter Property="Foreground" Value="#303030"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="2"/>
          <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border></Grid>
        </Grid>
          <ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True">
            <Setter TargetName="PART_Indicator" Property="Width" Value="85"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-85" To="340" Duration="0:0:1.6"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Border.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Margin="28,0,16,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="Logo" Width="30" Height="30" Margin="0,0,10,0"/>
        <TextBlock Text="Clipper" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Width="1" Height="16" Background="#E8E8E8" Margin="16,0"/>
        <TextBlock x:Name="HeaderLabel" Foreground="#858585" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="LanguageButton" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button x:Name="MinimizeButton" Grid.Column="2" VerticalAlignment="Center" Height="34" Padding="10">
        <Path Data="M 0,5 L 12,5" Stroke="#777777" StrokeThickness="1.2" Width="12" Height="10" Stretch="None"/>
      </Button>
      <Button x:Name="CloseButton" Grid.Column="3" VerticalAlignment="Center" Height="34" Padding="10">
        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#777777" StrokeThickness="1.2" Width="10" Height="10"/>
      </Button>
    </Grid>
    <Grid Grid.Row="1" Margin="40,24,40,28">
      <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#F6F6F6" CornerRadius="14" Padding="24,28">
        <StackPanel><Image x:Name="AppLogo" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,24"/>
          <TextBlock Text="Clipper" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="VersionLabel" Foreground="#767676" FontSize="12" Margin="0,8,0,0"/>
          <TextBlock x:Name="PlatformLabel" Foreground="#767676" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock x:Name="HeroTitle" FontSize="24" LineHeight="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="HeroDescription" Margin="0,14,0,0" Foreground="#767676" FontSize="13" LineHeight="22" TextWrapping="Wrap"/>
        <Border x:Name="LocationPanel" BorderBrush="#EAEAEA" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,24,0,0">
          <StackPanel><TextBlock x:Name="LocationLabel" FontSize="12" Foreground="#767676" Margin="0,0,0,8"/>
            <TextBlock x:Name="LocationValue" FontSize="12" Foreground="#202020" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,28,0,0">
          <Grid Margin="0,0,0,12"><TextBlock x:Name="ProgressLabel" Foreground="#555555" FontSize="12"/>
            <TextBlock x:Name="ProgressNumber" HorizontalAlignment="Right" Foreground="#767676" FontSize="12"/></Grid>
          <ProgressBar x:Name="InstallationProgress" Minimum="0" Maximum="100"/>
        </StackPanel>
        <Button x:Name="LogButton" HorizontalAlignment="Left" Padding="0,8" Margin="0,8,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="40,0,40,0">
      <Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#EEEEEE"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="FooterTitle" Foreground="#555555" FontSize="12"/>
          <TextBlock x:Name="FooterDescription" Foreground="#999999" FontSize="11" Margin="0,6,0,0"/></StackPanel>
        <Button x:Name="SecondaryButton" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Height="36" MinWidth="72"/>
        <Button x:Name="PrimaryButton" Grid.Column="2" VerticalAlignment="Center" Width="148" Height="44" Background="#303030" Foreground="White" FontSize="14" FontWeight="Medium" IsDefault="True"/>
      </Grid>
    </Grid>
  </Grid>
</Border>
